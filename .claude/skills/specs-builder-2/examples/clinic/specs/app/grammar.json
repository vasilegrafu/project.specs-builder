  "relations": {
    "serves": {"back": "served by", "from": ["requirement", "flow"], "to": ["goal"], "field": "serves", "least": 1, "unless": {"priority": "wont"}, "least of": ["requirement"], "stale": "to"},
    "enforces": {"back": "enforced by", "from": ["requirement"], "to": ["rule"], "field": "enforces", "stale": "to"},
    "depends on": {"back": "needed by", "from": ["requirement"], "to": ["requirement"], "field": "depends on", "acyclic": true, "stale": "to"},
    "refines": {"back": "refined by", "from": ["requirement"], "to": ["requirement"], "field": "refines", "acyclic": true, "stale": "to"},
    "conflicts with": {"back": "conflicts with", "from": ["requirement"], "to": ["requirement"], "field": "conflicts with", "stale": "both"},
    "governs": {"back": "governed by", "from": ["rule"], "to": ["entity"], "field": "applies to", "stale": "both"},
    "has": {"back": "part of", "from": ["requirement", "screen", "component", "entity"], "to": ["criterion", "element", "part", "state"], "section": true, "least": 1, "unless": {"priority": "wont"}, "least of": ["requirement"], "stale": "none"},
    "may": {"back": "may be done by", "from": ["role"], "to": ["requirement", "flow", "endpoint", "screen"], "section": "Actions", "answer": "yes", "stale": "to"},
