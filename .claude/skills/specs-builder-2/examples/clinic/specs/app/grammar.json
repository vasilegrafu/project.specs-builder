  "words": {
    "about": "what a review reads for, the same as references/writing.md's fixed words: a vague word in a requirement, a criterion or a quality; a technology word in a requirement; a requirement's statement opening with none of the opening words. Noted by `spec.py open`, never refused",
    "opening": ["The", "When", "While", "Where", "If"],
    "qualities": ["speed", "capacity", "availability", "security", "privacy", "accessibility", "devices", "languages", "proof"],
    "vague": ["fast", "quick", "quickly", "slow", "instant", "instantly", "immediately", "real-time", "responsive", "performant", "efficient",
              "easy", "easily", "simple", "simply", "intuitive", "user-friendly", "seamless", "smooth", "clean", "modern",
